---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
interface Props { project: CollectionEntry<'projects'>; number?: string; showImage?: boolean; }
const { project, number = '01', showImage = true } = Astro.props;
const { data } = project;
---
<article class:list={['project-feature', { 'project-feature--text': !showImage }]}>
  {showImage && <a class="project-feature__visual" href={`/projects/${project.id}/`} aria-label={`Explore ${data.title}`}>
    {data.cover && <Image src={data.cover} alt={data.coverAlt ?? data.title} widths={[480, 800, 1088]} sizes="(max-width: 760px) 90vw, 50vw" format="webp" loading="lazy" />}
    <span class="visual-index">{number} / {data.title}</span>
    <span class="visual-open"><Arrow /></span>
  </a>}
  <div class="project-feature__body">
    <div class="project-meta"><span>Project / {number}</span><span class="status"><span aria-hidden="true"></span>{data.status}</span></div>
    <h3><a href={`/projects/${project.id}/`}>{data.title}</a></h3>
    <p class="project-summary">{data.summary}</p>
    <dl class="project-facts">
      {data.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
    </dl>
    <ul class="tags" aria-label="Project tools">{data.tags.map(tag => <li>{tag}</li>)}</ul>
    <a class="text-link" href={`/projects/${project.id}/`}>Explore the project <Arrow /></a>
  </div>
</article>
