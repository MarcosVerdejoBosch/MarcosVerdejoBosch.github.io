---
import { navigation, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
---
<header class="site-header shell">
  <a class="identity" href="/" aria-label={`${site.name}, home`}>
    <span class="identity__mark" aria-hidden="true">MVB</span>
    <span class="identity__text">{site.name}<span>{site.role}</span></span>
  </a>
  <div class="header-actions">
    <nav aria-label="Main navigation">
      {navigation.map(({ label, href }) => (
        <a
          href={href}
          class:list={{ 'is-active': !href.includes('#') && path.startsWith(href) }}
          aria-current={path === href ? 'page' : undefined}
        >{label}</a>
      ))}
    </nav>
    <ThemeToggle />
  </div>
</header>
