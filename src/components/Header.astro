---
import { navigation } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
const activePath = path.startsWith('/projects/') ? '/projects/' : path;
const currentKind = path === activePath ? 'page' : 'location';
const links = [{ label: 'Home', href: '/' }, ...navigation];
---
<header class="site-header">
  <nav aria-label="Main navigation">
    <ul role="list">
      {links.map(({ label, href }) => (
        <li>
          <a href={href} aria-current={href === activePath ? currentKind : undefined}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <ThemeToggle />
</header>
