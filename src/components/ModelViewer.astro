---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { model: string; poster: ImageMetadata; alt: string; }
const { model, poster, alt } = Astro.props;
---
<figure class="model-figure" data-model-viewer data-src={model}>
  <div class="model-stage">
    <Image
      class="model-poster"
      src={poster}
      alt={alt}
      width={1280}
      widths={[320, 480, 640, 800, 1088, 1280]}
      sizes="(max-width: 370px) calc(100vw - 48px), (max-width: 810px) 87vw, 704px"
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
    <div class="model-toolbar" hidden>
      <span>Drag to rotate · scroll to zoom</span>
      <button type="button" data-reset-model>Reset view <span aria-hidden="true">↺</span></button>
    </div>
  </div>
  <figcaption>
    <div class="model-caption">
      <span>KiCad render</span>
      <div class="model-launch" hidden>
        <button class="text-link model-trigger" type="button" data-load-model aria-describedby="model-size">Explore in 3D</button>
        <span id="model-size">19 MB</span>
      </div>
    </div>
    <p class="model-message" data-model-message role="status" aria-live="polite"></p>
    <noscript><p class="model-fallback">The interactive viewer needs JavaScript. You can <a href={model} download>download the PCB model</a> to inspect it locally.</p></noscript>
  </figcaption>
</figure>
<script>
  import type { ModelViewerElement } from '@google/model-viewer';

  for (const figure of document.querySelectorAll<HTMLElement>('[data-model-viewer]')) {
    const stage = figure.querySelector<HTMLElement>('.model-stage');
    const button = figure.querySelector<HTMLButtonElement>('[data-load-model]');
    const message = figure.querySelector<HTMLElement>('[data-model-message]');
    const toolbar = figure.querySelector<HTMLElement>('.model-toolbar');
    const launch = figure.querySelector<HTMLElement>('.model-launch');
    const reset = figure.querySelector<HTMLButtonElement>('[data-reset-model]');
    if (!stage || !button || !message || !toolbar || !launch) continue;
    launch.hidden = false;
    reset?.addEventListener('click', () => {
      const viewer = stage.querySelector<ModelViewerElement>('model-viewer');
      if (!viewer) return;
      viewer.cameraOrbit = '0deg 0deg 100%';
      viewer.cameraTarget = 'auto auto auto';
      viewer.jumpCameraToGoal();
    });

    button.addEventListener('click', async () => {
      button.disabled = true;
      stage.setAttribute('aria-busy', 'true');
      button.textContent = 'Loading viewer…';
      message.textContent = 'Loading the interactive PCB model.';
      try {
        await import('@google/model-viewer');
        await customElements.whenDefined('model-viewer');
        const viewer = document.createElement('model-viewer') as ModelViewerElement;
        viewer.setAttribute('alt', 'Interactive 3D model of the linear regulator PCB');
        viewer.setAttribute('camera-controls', '');
        viewer.setAttribute('touch-action', 'pan-y');
        viewer.setAttribute('interaction-prompt', 'none');
        viewer.setAttribute('camera-orbit', '0deg 0deg 100%');
        viewer.setAttribute('shadow-intensity', '0');
        viewer.setAttribute('exposure', '1.1');
        viewer.setAttribute('tabindex', '0');
        viewer.addEventListener('load', () => {
          stage.classList.add('is-loaded');
          stage.setAttribute('aria-busy', 'false');
          toolbar.hidden = false;
          launch.hidden = true;
          message.textContent = '3D model ready. Use the mouse, touch, or arrow keys to rotate.';
          viewer.focus();
        }, { once: true });
        viewer.addEventListener('error', () => {
          viewer.remove();
          stage.classList.remove('is-loaded');
          stage.setAttribute('aria-busy', 'false');
          toolbar.hidden = true;
          launch.hidden = false;
          button.disabled = false;
          button.textContent = 'Try loading 3D again';
          message.textContent = 'The 3D model could not be loaded. The PCB image is still available.';
        }, { once: true });
        viewer.setAttribute('src', figure.dataset.src ?? '');
        stage.append(viewer);
      } catch {
        stage.setAttribute('aria-busy', 'false');
        button.disabled = false;
        button.textContent = 'Try loading 3D again';
        message.textContent = 'The viewer could not start. Please try again.';
      }
    });
  }
</script>
