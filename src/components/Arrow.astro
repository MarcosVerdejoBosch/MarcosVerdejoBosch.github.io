---
interface Props { direction?: 'diagonal' | 'right' | 'down'; class?: string; }
const { direction = 'diagonal', class: className } = Astro.props;
const paths = {
  diagonal: 'M4 16 16 4M4 4h12v12',
  right: 'M3 10h14m-6-6 6 6-6 6',
  down: 'M10 3v14m-6-6 6 6 6-6',
};
---
<svg class={className} width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d={paths[direction]} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
