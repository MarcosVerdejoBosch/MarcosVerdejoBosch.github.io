---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModelViewer from '../../components/ModelViewer.astro';
import '../../styles/commit-mono.css';
import '../../styles/project-detail.css';
export async function getStaticPaths() {
  const projects = await getCollection('projects', entry => !entry.data.draft);
  return projects.map(project => ({ params: { slug: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { data } = project;
const [highlight] = data.facts;
const { Content, headings } = await render(project);
const sections = headings.filter(heading => heading.depth === 2);
const showIndex = sections.length > 1;
---
<BaseLayout title={data.title} description={data.summary}>
  <article class="project-detail">
    <a class="back-link" href="/projects/"><span aria-hidden="true">←</span> All projects</a>
    <header class="project-heading">
      <p class="project-meta">{data.discipline} <span class="project-status">{data.status}</span></p>
      <h1 class="page-title">{data.title}</h1>
      <p class="page-intro-copy">{data.summary}</p>
      {highlight && (
        <dl class="project-highlight">
          <dt>{highlight.label}</dt>
          <dd>{highlight.value}</dd>
        </dl>
      )}
    </header>
    {data.cover && (
      <div class="project-visual">
        {data.model
          ? <ModelViewer model={data.model} poster={data.cover} alt={data.coverAlt ?? data.title} />
          : <Image class="report-cover" src={data.cover} alt={data.coverAlt ?? data.title} width={1088} format="webp" />
        }
      </div>
    )}
    <div class:list={['report-layout', { 'report-layout--short': !showIndex }]}>
      {showIndex && (
        <aside class="report-index">
          <details class="report-index__sections" open>
            <summary class="report-index__title" id="report-index-title">On this page</summary>
            <nav aria-labelledby="report-index-title">
              <ol>
                {sections.map(heading => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ol>
            </nav>
          </details>
        </aside>
      )}
      <div class="prose"><Content /></div>
    </div>
    <div class="report-end"><a class="back-link" href="/projects/"><span aria-hidden="true">←</span> All projects</a></div>
  </article>
</BaseLayout>
<script>
  const sections = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')];
  for (const section of sections) section.tabIndex = -1;

  const reportSections = document.querySelector<HTMLDetailsElement>('.report-index__sections');
  if (reportSections) {
    const narrowIndex = window.matchMedia('(max-width: 760px)');
    const syncIndex = () => { reportSections.open = !narrowIndex.matches; };
    syncIndex();
    narrowIndex.addEventListener('change', syncIndex);

    const indexLinks = [...reportSections.querySelectorAll<HTMLAnchorElement>('nav a')];
    let scheduled = false;
    const updateIndex = () => {
      const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 8;
      const current = atBottom ? sections.at(-1) : sections.filter(section => section.getBoundingClientRect().top <= 150).at(-1) ?? sections[0];
      for (const link of indexLinks) {
        if (link.hash === `#${current?.id}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
      scheduled = false;
    };
    window.addEventListener('scroll', () => { if (!scheduled) { scheduled = true; requestAnimationFrame(updateIndex); } }, { passive: true });
    window.addEventListener('hashchange', updateIndex);
    updateIndex();
  }
</script>
