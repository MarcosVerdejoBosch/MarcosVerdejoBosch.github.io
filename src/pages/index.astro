---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { navigation, site } from '../data/site';

const introduction = 'I like building things I can use: circuits, software, and audio tools.';
const currentWork = 'I work on Google Cloud infrastructure.';
const bio = `${introduction} ${currentWork}`;
---

<BaseLayout variant="home" description={bio}>
  <div class="home-theme"><ThemeToggle /></div>
  <section class="home-intro" aria-labelledby="intro-title">
    <h1 id="intro-title">{site.name}</h1>
    <p class="home-role">{site.role}</p>
    <p class="home-bio">{introduction}</p>
    <p class="home-work">{currentWork}</p>
    <nav class="home-navigation" aria-label="Main navigation">
      <ul role="list">
        {navigation.map(({ label, href, description }) => (
          <li>
            <a href={href}>
              <span class="destination-title">{label}</span>
              <span class="destination-description">{description}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  .home-theme {
    position: absolute;
    inset-block-start: clamp(14px, 3.6vh, 36px);
    inset-inline-end: clamp(16px, 2.6vw, 42px);
  }

  .home-theme :global(.theme-toggle) {
    color: var(--accent-text);
  }

  h1 {
    font-size: clamp(2.25rem, 4.6vw, 4.55rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -.043em;
    text-wrap: balance;
  }

  .home-role {
    margin-block-start: 15px;
    color: var(--accent-text);
    font-size: clamp(17px, 1.66vw, 26px);
    line-height: 1.3;
  }

  .home-bio {
    margin-block-start: clamp(24px, 3vw, 39px);
    max-inline-size: 38ch;
    font-size: clamp(18px, 2.05vw, 32px);
    line-height: 1.42;
    text-wrap: pretty;
  }

  .home-work {
    margin-block-start: 14px;
    color: color-mix(in srgb, var(--foreground) 88%, var(--background));
    font-size: clamp(16px, 1.64vw, 26px);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .home-navigation {
    max-inline-size: 43rem;
    margin-block-start: clamp(32px, 3.5vw, 54px);
  }

  .home-navigation ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px clamp(24px, 3.4vw, 54px);
    padding: 0;
    list-style: none;
  }

  .home-navigation a {
    display: grid;
    align-content: start;
    gap: 6px;
    min-block-size: 44px;
    margin-inline: -10px;
    padding: 8px 10px;
    border-radius: 4px;
  }

  .home-navigation a:hover,
  .home-navigation a:active {
    background: var(--surface);
  }

  .destination-title {
    color: var(--accent-text);
    font-size: clamp(16px, 1.65vw, 26px);
    font-weight: 550;
    line-height: 1.3;
  }

  .destination-description {
    color: var(--muted);
    font-size: clamp(14px, 1.3vw, 20px);
    line-height: 1.4;
  }

  @media (max-width: 760px) {
    h1 {
      font-size: clamp(2.125rem, 9.4vw, 3.25rem);
    }
  }

  @media (max-width: 640px) {
    .home-navigation ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
