---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
---
<BaseLayout title="About">
  <div class="page-flow">
    <section aria-labelledby="about-title">
      <h1 class="page-title" id="about-title">About</h1>
      <p class="about-intro">I’m Marcos Verdejo Bosch, an electronic engineer. I like designing and building things I can use myself.</p>
    </section>

    <section class="about-work" aria-labelledby="focus-title">
      <h2 class="section-title" id="focus-title">What I work on</h2>
      <p class="about-work__statement">
        On my own, I design analog circuits and write software to analyze and <span>visualize sound</span>.
      </p>
      <div class="about-work__notes">
        <div>
          <p>Power supplies, PCB design, and embedded systems</p>
          <p class="about-work__tools">KiCad · LTspice · ESP32 · C · C++ · Python</p>
        </div>
        <div class="about-work__job">
          <h3>Day job</h3>
          <p>I work on Google Cloud infrastructure.</p>
        </div>
      </div>
      <a class="text-link" href="/projects/">View projects <Arrow direction="right" /></a>
    </section>
  </div>
</BaseLayout>
