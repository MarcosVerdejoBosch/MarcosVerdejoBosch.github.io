{
  "name": "marcos-verdejo-bosch-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:assets && astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "npm run prepare:assets && astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test:theme": "node --test scripts/theme.test.mjs",
    "verify": "npm run test:theme && node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/commit-mono": "5.3.0",
    "@google/model-viewer": "4.4.0",
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3"
  }
}
